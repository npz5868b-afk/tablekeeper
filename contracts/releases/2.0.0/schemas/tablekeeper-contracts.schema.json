{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tablekeeper.local/contracts/2.0.0/tablekeeper-contracts.schema.json",
  "title": "Tablekeeper C01-C12 contract definitions 2.0.0",
  "type": "object",
  "$defs": {
    "Uuid": {"type":"string","format":"uuid"},
    "Instant": {"type":"string","format":"date-time","pattern":"Z$"},
    "Digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "LocalTimeInput": {"type":"object","required":["localDateTime","timeZone","utcOffset","fold"],"properties":{"localDateTime":{"type":"string","format":"date-time-local"},"timeZone":{"type":"string","format":"iana-time-zone"},"utcOffset":{"type":"string","pattern":"^[+-](0[0-9]|1[0-4]):[0-5][0-9]$"},"fold":{"enum":[0,1]}},"additionalProperties":false},
    "ContractRef": {"type":"object","required":["contractId","contractVersion"],"properties":{"contractId":{"type":"string","pattern":"^C(0[1-9]|1[0-2])$"},"contractVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}},"additionalProperties":false},
    "Actor": {"type":"object","required":["actorType","actorId"],"properties":{"actorType":{"enum":["GUEST","STAFF","MANAGER","SYSTEM"]},"actorId":{"type":"string","minLength":1}},"additionalProperties":false},
    "CommandEnvelope": {"type":"object","required":["contract","tenantId","commandId","idempotencyKey","correlationId","issuedAt","actor","commandType","payload"],"properties":{"contract":{"$ref":"#/$defs/ContractRef"},"tenantId":{"$ref":"#/$defs/Uuid"},"commandId":{"$ref":"#/$defs/Uuid"},"idempotencyKey":{"type":"string","minLength":16,"maxLength":128},"correlationId":{"$ref":"#/$defs/Uuid"},"issuedAt":{"$ref":"#/$defs/Instant"},"actor":{"$ref":"#/$defs/Actor"},"commandType":{"type":"string","minLength":1},"expectedVersion":{"type":"integer","minimum":0},"payload":{"type":"object"}},"additionalProperties":false},
    "QueryEnvelope": {"type":"object","required":["contract","tenantId","queryId","correlationId","issuedAt","actor","queryType","parameters"],"properties":{"contract":{"$ref":"#/$defs/ContractRef"},"tenantId":{"$ref":"#/$defs/Uuid"},"queryId":{"$ref":"#/$defs/Uuid"},"correlationId":{"$ref":"#/$defs/Uuid"},"issuedAt":{"$ref":"#/$defs/Instant"},"actor":{"$ref":"#/$defs/Actor"},"queryType":{"type":"string"},"parameters":{"type":"object"}},"additionalProperties":false},
    "AvailabilitySearchParameters": {"type":"object","required":["venueId","partySize","requestedRange"],"properties":{"venueId":{"$ref":"#/$defs/Uuid"},"partySize":{"type":"integer","minimum":1},"requestedRange":{"$ref":"#/$defs/TimeRange"}},"additionalProperties":false},
    "AvailabilitySearchRequest": {"allOf":[{"$ref":"#/$defs/QueryEnvelope"},{"type":"object","properties":{"contract":{"type":"object","required":["contractId","contractVersion"],"properties":{"contractId":{"const":"C03"},"contractVersion":{"const":"2.0.0"}},"additionalProperties":false},"queryType":{"const":"SEARCH_AVAILABILITY"},"parameters":{"$ref":"#/$defs/AvailabilitySearchParameters"}}}]},
    "ReservationSelection": {"type":"object","required":["candidateId","resourceIds"],"properties":{"candidateId":{"$ref":"#/$defs/Uuid"},"resourceIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Uuid"}}},"additionalProperties":false},
    "ReservationPreparationPayload": {"type":"object","required":["venueId","partySize","requestedRange","selection"],"properties":{"venueId":{"$ref":"#/$defs/Uuid"},"partySize":{"type":"integer","minimum":1},"requestedRange":{"$ref":"#/$defs/TimeRange"},"selection":{"$ref":"#/$defs/ReservationSelection"}},"additionalProperties":false},
    "ReservationPreparationRequest": {"allOf":[{"$ref":"#/$defs/CommandEnvelope"},{"type":"object","properties":{"contract":{"type":"object","required":["contractId","contractVersion"],"properties":{"contractId":{"const":"C04"},"contractVersion":{"const":"2.0.0"}},"additionalProperties":false},"commandType":{"const":"PREPARE_RESERVATION"},"payload":{"$ref":"#/$defs/ReservationPreparationPayload"}}}]},
    "ReservationConfirmationPayload": {"type":"object","required":["confirmationToken","acceptedTerms"],"properties":{"confirmationToken":{"$ref":"#/$defs/ConfirmationToken"},"acceptedTerms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/AcceptedTerms"}}},"additionalProperties":false},
    "ReservationConfirmationRequest": {"allOf":[{"$ref":"#/$defs/CommandEnvelope"},{"type":"object","properties":{"contract":{"type":"object","required":["contractId","contractVersion"],"properties":{"contractId":{"const":"C04"},"contractVersion":{"const":"2.0.0"}},"additionalProperties":false},"commandType":{"const":"CONFIRM_RESERVATION"},"payload":{"$ref":"#/$defs/ReservationConfirmationPayload"}}}]},
    "Error": {"type":"object","required":["code","message","retryable","correlationId"],"properties":{"code":{"enum":["VALIDATION_FAILED","AUTH_REQUIRED","AUTH_FORBIDDEN","TENANT_SCOPE_VIOLATION","NOT_FOUND","PRECONDITION_REQUIRED","CONFLICT_ALLOCATION","CONFLICT_STATE","STALE_VERSION","STALE_RESOURCE_SNAPSHOT","IDEMPOTENCY_KEY_REUSED","TOKEN_INVALID","TOKEN_EXPIRED","TOKEN_SCOPE_MISMATCH","TOKEN_CONSUMED","POLICY_VERSION_NOT_FOUND","TERMS_NOT_ACCEPTED","CONTRACT_VERSION_UNSUPPORTED","CAPABILITY_UNAVAILABLE","DEPENDENCY_UNAVAILABLE","PLAN_INVALID","PLAN_STALE","PLAN_APPROVAL_REQUIRED","INTERNAL"]},"message":{"type":"string","minLength":1},"retryable":{"type":"boolean"},"correlationId":{"$ref":"#/$defs/Uuid"},"details":{"type":"object","additionalProperties":true}},"additionalProperties":false},
    "OperationResult": {"oneOf":[{"type":"object","required":["ok","correlationId","contract","result"],"properties":{"ok":{"const":true},"correlationId":{"$ref":"#/$defs/Uuid"},"contract":{"$ref":"#/$defs/ContractRef"},"result":{}},"additionalProperties":false},{"type":"object","required":["ok","correlationId","contract","error"],"properties":{"ok":{"const":false},"correlationId":{"$ref":"#/$defs/Uuid"},"contract":{"$ref":"#/$defs/ContractRef"},"error":{"$ref":"#/$defs/Error"}},"additionalProperties":false}]},
    "TimeRange": {"type":"object","description":"Half-open interval [start,end)","required":["start","end"],"properties":{"start":{"$ref":"#/$defs/Instant"},"end":{"$ref":"#/$defs/Instant"}},"additionalProperties":false},
    "AtomicResource": {"type":"object","required":["resourceId","resourceType"],"properties":{"resourceId":{"$ref":"#/$defs/Uuid"},"resourceType":{"const":"TABLE"}},"additionalProperties":false},
    "AllocationCandidate": {"type":"object","required":["candidateId","resources","timeRange","advisory","observedAt"],"properties":{"candidateId":{"$ref":"#/$defs/Uuid"},"resources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/AtomicResource"}},"timeRange":{"$ref":"#/$defs/TimeRange"},"advisory":{"const":true},"observedAt":{"$ref":"#/$defs/Instant"}},"additionalProperties":false},
    "AvailabilityResult": {"type":"object","required":["tenantId","venueId","candidates","authoritativeAtCommitOnly"],"properties":{"tenantId":{"$ref":"#/$defs/Uuid"},"venueId":{"$ref":"#/$defs/Uuid"},"candidates":{"type":"array","items":{"$ref":"#/$defs/AllocationCandidate"}},"authoritativeAtCommitOnly":{"const":true}},"additionalProperties":false},
    "ConfirmationTokenClaims": {"type":"object","required":["tokenId","tenantId","venueId","preparationId","partySize","timeRange","policyVersionIds","termsDigest","issuedAt","expiresAt"],"properties":{"tokenId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"venueId":{"$ref":"#/$defs/Uuid"},"preparationId":{"$ref":"#/$defs/Uuid"},"partySize":{"type":"integer","minimum":1},"timeRange":{"$ref":"#/$defs/TimeRange"},"proposedResourceIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/Uuid"}},"policyVersionIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Uuid"}},"termsDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"issuedAt":{"$ref":"#/$defs/Instant"},"expiresAt":{"$ref":"#/$defs/Instant"}},"additionalProperties":false},
    "AcceptedTerms": {"type":"object","required":["policyVersionId","termsDigest","acceptedAt","acceptedBy"],"properties":{"policyVersionId":{"$ref":"#/$defs/Uuid"},"termsDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"acceptedAt":{"$ref":"#/$defs/Instant"},"acceptedBy":{"$ref":"#/$defs/Actor"},"acceptanceChannel":{"enum":["WEB","STAFF","API"]}},"additionalProperties":false},
    "Reservation": {"type":"object","required":["reservationId","tenantId","venueId","status","version","partySize","timeRange","occupiedRange","resources","acceptedTerms","createdAt","updatedAt"],"properties":{"reservationId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"venueId":{"$ref":"#/$defs/Uuid"},"status":{"enum":["CONFIRMED","CANCELLED","COMPLETED","NO_SHOW"]},"version":{"type":"integer","minimum":1},"partySize":{"type":"integer","minimum":1},"timeRange":{"$ref":"#/$defs/TimeRange"},"occupiedRange":{"$ref":"#/$defs/TimeRange"},"resources":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/AtomicResource"}},"acceptedTerms":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/AcceptedTerms"}},"createdAt":{"$ref":"#/$defs/Instant"},"updatedAt":{"$ref":"#/$defs/Instant"}},"additionalProperties":false},
    "Preparation": {"type":"object","required":["preparationId","tenantId","venueId","partySize","requestedRange","resolvedResourceSnapshot","policyVersionIds","termsDigest","termsArtifact","createdAt","expiresAt","status","confirmationToken"],"properties":{"preparationId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"venueId":{"$ref":"#/$defs/Uuid"},"partySize":{"type":"integer","minimum":1},"requestedRange":{"$ref":"#/$defs/TimeRange"},"resolvedResourceSnapshot":{"$ref":"#/$defs/TableGroupSnapshot"},"policyVersionIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Uuid"}},"termsDigest":{"$ref":"#/$defs/Digest"},"termsArtifact":{"type":"string","minLength":1},"createdAt":{"$ref":"#/$defs/Instant"},"expiresAt":{"$ref":"#/$defs/Instant"},"status":{"enum":["OPEN","CONSUMED","EXPIRED","REVOKED"]},"confirmationToken":{"$ref":"#/$defs/ConfirmationToken"}},"additionalProperties":false},
    "ConfirmationToken": {"type":"string","minLength":32,"maxLength":8192,"description":"Opaque authenticated transport token; clients MUST NOT decode it"},
    "ExpectedVersionCommand": {"type":"object","required":["expectedVersion","ifMatchVersion"],"properties":{"expectedVersion":{"type":"integer","minimum":1},"ifMatchVersion":{"type":"integer","minimum":1}},"additionalProperties":false},
    "IdempotencyRecord": {"type":"object","required":["tenantId","commandType","idempotencyKeyDigest","requestFingerprint","status","retentionUntil","responseContractVersion"],"properties":{"tenantId":{"$ref":"#/$defs/Uuid"},"commandType":{"type":"string","minLength":1},"idempotencyKeyDigest":{"$ref":"#/$defs/Digest"},"requestFingerprint":{"$ref":"#/$defs/Digest","description":"RFC 8785 semantic body bytes hashed with SHA-256"},"status":{"enum":["IN_PROGRESS","TERMINAL"]},"retentionUntil":{"$ref":"#/$defs/Instant"},"leaseOwner":{"type":"string"},"logicalResult":{"$ref":"#/$defs/OperationResult"},"responseContractVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}},"additionalProperties":false},
    "TableGroupSnapshot": {"type":"object","required":["groupId","groupVersion","resourceIds"],"properties":{"groupId":{"$ref":"#/$defs/Uuid"},"groupVersion":{"type":"integer","minimum":1},"resourceIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Uuid"}}},"additionalProperties":false},
    "PolicyVersion": {"type":"object","required":["policyVersionId","tenantId","category","canonicalContentDigest","renderedTermsArtifact","publishedAt","immutable"],"properties":{"policyVersionId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"category":{"enum":["BOOKING_CANCELLATION","DEPOSIT","PRIVACY_NOTICE","VENUE_RULES"]},"canonicalContentDigest":{"$ref":"#/$defs/Digest"},"renderedTermsArtifact":{"type":"string","minLength":1},"locale":{"type":"string"},"publishedAt":{"$ref":"#/$defs/Instant"},"immutable":{"const":true}},"additionalProperties":false},
    "DiningIntent": {"type":"object","required":["intentType","confidence","sourceMode","slots"],"properties":{"intentType":{"enum":["SEARCH_AVAILABILITY","PREPARE_RESERVATION","CONFIRM_RESERVATION","RETRIEVE_RESERVATION","MODIFY_RESERVATION","CANCEL_RESERVATION","ASK_POLICY","UNKNOWN"]},"confidence":{"type":"number","minimum":0,"maximum":1},"sourceMode":{"enum":["FULL_AI","LOCAL_AI","SURVIVAL"]},"slots":{"type":"object"},"missingRequiredSlots":{"type":"array","uniqueItems":true,"items":{"type":"string"}}},"additionalProperties":false},
    "ToolDefinition": {"type":"object","required":["toolName","toolVersion","inputSchemaRef","outputSchemaRef","stateEffect","requiredCapability"],"properties":{"toolName":{"type":"string","pattern":"^[a-z][a-z0-9_.-]+$"},"toolVersion":{"type":"string"},"inputSchemaRef":{"type":"string"},"outputSchemaRef":{"type":"string"},"stateEffect":{"enum":["QUERY","COMMAND"]},"requiredCapability":{"type":"string"}},"additionalProperties":false},
    "IntelligenceState": {"type":"object","required":["mode","capabilities","observedAt","reasonCode"],"properties":{"mode":{"enum":["FULL_AI","LOCAL_AI","SURVIVAL"]},"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"observedAt":{"$ref":"#/$defs/Instant"},"reasonCode":{"type":"string"},"dependencyHealth":{"type":"object","additionalProperties":{"enum":["AVAILABLE","DEGRADED","UNAVAILABLE"]}}},"additionalProperties":false},
    "SourceVersion": {"type":"object","required":["sourceId","sourceVersion","tenantId","aclPrincipals","validFrom","validTo","publishedAt","ingestedAt","contentDigest","tombstoned"],"properties":{"sourceId":{"$ref":"#/$defs/Uuid"},"sourceVersion":{"type":"string","minLength":1},"tenantId":{"$ref":"#/$defs/Uuid"},"aclPrincipals":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"validFrom":{"$ref":"#/$defs/Instant"},"validTo":{"oneOf":[{"$ref":"#/$defs/Instant"},{"type":"null"}]},"publishedAt":{"$ref":"#/$defs/Instant"},"ingestedAt":{"$ref":"#/$defs/Instant"},"contentDigest":{"$ref":"#/$defs/Digest"},"supersedesVersion":{"type":"string"},"tombstoned":{"type":"boolean"}},"additionalProperties":false},
    "Citation": {"type":"object","required":["sourceId","sourceVersion","tenantId","contentDigest","locator","spanStart","spanEnd","retrievalTraceId"],"properties":{"sourceId":{"$ref":"#/$defs/Uuid"},"sourceVersion":{"type":"string","minLength":1},"tenantId":{"$ref":"#/$defs/Uuid"},"contentDigest":{"$ref":"#/$defs/Digest"},"locator":{"type":"string","minLength":1},"spanStart":{"type":"integer","minimum":0},"spanEnd":{"type":"integer","minimum":1},"retrievalTraceId":{"$ref":"#/$defs/Uuid"}},"additionalProperties":false},
    "RetrievalTrace": {"type":"object","required":["traceId","tenantId","callerAclDigest","asOf","queryDigest","filterAppliedBeforeRanking","channels","sourceVersions","citations","notTransactionalTruth"],"properties":{"traceId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"callerAclDigest":{"$ref":"#/$defs/Digest"},"asOf":{"$ref":"#/$defs/Instant"},"queryDigest":{"$ref":"#/$defs/Digest"},"filterAppliedBeforeRanking":{"const":true},"channels":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["LEXICAL","DENSE","RRF","RERANK"]}},"sourceVersions":{"type":"array","items":{"$ref":"#/$defs/SourceVersion"}},"citations":{"type":"array","items":{"$ref":"#/$defs/Citation"}},"notTransactionalTruth":{"const":true}},"additionalProperties":false},
    "ReplanProposal": {"type":"object","required":["planId","tenantId","snapshotId","snapshotVersion","proposalDigest","proposedChanges","expectedVersions"],"properties":{"planId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"snapshotId":{"$ref":"#/$defs/Uuid"},"snapshotVersion":{"type":"integer","minimum":1},"proposalDigest":{"$ref":"#/$defs/Digest"},"proposedChanges":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":true}},"expectedVersions":{"type":"object","minProperties":1,"additionalProperties":{"type":"integer","minimum":1}}},"additionalProperties":false},
    "ReplanValidation": {"type":"object","required":["proposalDigest","snapshotId","snapshotVersion","validatorVersion","ruleSetVersion","valid","violations","validationDigest"],"properties":{"proposalDigest":{"$ref":"#/$defs/Digest"},"snapshotId":{"$ref":"#/$defs/Uuid"},"snapshotVersion":{"type":"integer","minimum":1},"validatorVersion":{"type":"string","minLength":1},"ruleSetVersion":{"type":"string","minLength":1},"valid":{"type":"boolean"},"violations":{"type":"array","items":{"type":"string"}},"validationDigest":{"$ref":"#/$defs/Digest"}},"additionalProperties":false},
    "ReplanApproval": {"type":"object","required":["proposalDigest","validationDigest","snapshotId","snapshotVersion","approver","approvedAt","expiresAt"],"properties":{"proposalDigest":{"$ref":"#/$defs/Digest"},"validationDigest":{"$ref":"#/$defs/Digest"},"snapshotId":{"$ref":"#/$defs/Uuid"},"snapshotVersion":{"type":"integer","minimum":1},"approver":{"$ref":"#/$defs/Actor"},"approvedAt":{"$ref":"#/$defs/Instant"},"expiresAt":{"$ref":"#/$defs/Instant"}},"additionalProperties":false},
    "ReplanApplyCommand": {"type":"object","required":["proposal","validation","approval","applySnapshotId","applySnapshotVersion","atomic"],"properties":{"proposal":{"$ref":"#/$defs/ReplanProposal"},"validation":{"$ref":"#/$defs/ReplanValidation"},"approval":{"$ref":"#/$defs/ReplanApproval"},"applySnapshotId":{"$ref":"#/$defs/Uuid"},"applySnapshotVersion":{"type":"integer","minimum":1},"atomic":{"const":true}},"additionalProperties":false},
    "ReplanPackage": {"type":"object","required":["proposal","validation","approval","status"],"properties":{"proposal":{"$ref":"#/$defs/ReplanProposal"},"validation":{"$ref":"#/$defs/ReplanValidation"},"approval":{"oneOf":[{"$ref":"#/$defs/ReplanApproval"},{"type":"null"}]},"status":{"enum":["PROPOSED","VALIDATED","REJECTED","APPROVED","APPLIED","STALE","APPLY_FAILED"]}},"additionalProperties":false},
    "AuditOutboxEnvelope": {"type":"object","required":["eventId","eventType","eventVersion","tenantId","aggregateId","aggregateVersion","commandId","idempotencyKeyDigest","correlationId","actor","occurredAt","outcome","buildId","payload"],"properties":{"eventId":{"$ref":"#/$defs/Uuid"},"eventType":{"type":"string"},"eventVersion":{"type":"string"},"tenantId":{"$ref":"#/$defs/Uuid"},"aggregateId":{"$ref":"#/$defs/Uuid"},"aggregateVersion":{"type":"integer","minimum":1},"commandId":{"$ref":"#/$defs/Uuid"},"idempotencyKeyDigest":{"$ref":"#/$defs/Digest"},"correlationId":{"$ref":"#/$defs/Uuid"},"actor":{"$ref":"#/$defs/Actor"},"occurredAt":{"$ref":"#/$defs/Instant"},"outcome":{"const":"COMMITTED"},"buildId":{"type":"string"},"payload":{"type":"object","additionalProperties":true}},"additionalProperties":false},
    "CommandAttempt": {"type":"object","required":["attemptId","tenantId","actor","commandId","correlationId","idempotencyKeyDigest","requestFingerprint","buildId","outcome","recordedAt"],"properties":{"attemptId":{"$ref":"#/$defs/Uuid"},"tenantId":{"$ref":"#/$defs/Uuid"},"actor":{"$ref":"#/$defs/Actor"},"commandId":{"$ref":"#/$defs/Uuid"},"correlationId":{"$ref":"#/$defs/Uuid"},"idempotencyKeyDigest":{"$ref":"#/$defs/Digest"},"requestFingerprint":{"$ref":"#/$defs/Digest"},"buildId":{"type":"string","minLength":1},"outcome":{"enum":["ACCEPTED","REJECTED","ROLLED_BACK","UNKNOWN_RESPONSE"]},"reasonCode":{"type":"string"},"recordedAt":{"$ref":"#/$defs/Instant"}},"additionalProperties":false},
    "ArtifactEvidence": {"type":"object","required":["path","sha256","mediaType","readOnlyRetained"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"mediaType":{"type":"string","minLength":1},"readOnlyRetained":{"const":true}},"additionalProperties":false},
    "TestExecutionEvidence": {"type":"object","required":["testId","testDefinitionDigest","executionId","startedAt","finishedAt","environmentDigest","result","artifactPaths"],"properties":{"testId":{"type":"string","minLength":1},"testDefinitionDigest":{"$ref":"#/$defs/Digest"},"executionId":{"$ref":"#/$defs/Uuid"},"startedAt":{"$ref":"#/$defs/Instant"},"finishedAt":{"$ref":"#/$defs/Instant"},"environmentDigest":{"$ref":"#/$defs/Digest"},"result":{"enum":["PASS","FAIL","SKIP"]},"artifactPaths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"observedFact":{"type":"string"},"interpretation":{"type":"string"}},"additionalProperties":false},
    "NetworkControlEvidence": {"type":"object","required":["internetDenied","control","artifactPath","artifactDigest"],"properties":{"internetDenied":{"const":true},"control":{"enum":["DOCKER_NETWORK_NONE","DOCKER_ISOLATED_NETWORKS","FIREWALL_POLICY","AIR_GAPPED_RUNNER"]},"artifactPath":{"type":"string","minLength":1},"artifactDigest":{"$ref":"#/$defs/Digest"}},"additionalProperties":false},
    "EvidenceManifest": {"type":"object","required":["manifestVersion","buildId","sourceRevision","dirtyState","dependencyLockDigests","imageDigests","contractDigests","environmentDigest","networkControl","tests","artifacts","retentionPolicy","createdAt"],"properties":{"manifestVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"buildId":{"type":"string","minLength":1},"sourceRevision":{"type":"string","minLength":1},"dirtyState":{"enum":["CLEAN","DIRTY","UNKNOWN"]},"dependencyLockDigests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Digest"}},"imageDigests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Digest"}},"contractDigests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/Digest"}},"environmentDigest":{"$ref":"#/$defs/Digest"},"networkControl":{"$ref":"#/$defs/NetworkControlEvidence"},"tests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/TestExecutionEvidence"}},"artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ArtifactEvidence"}},"retentionPolicy":{"type":"object","required":["mode","location","policyVersion"],"properties":{"mode":{"const":"READ_ONLY"},"location":{"type":"string","minLength":1},"policyVersion":{"type":"string","minLength":1}},"additionalProperties":false},"createdAt":{"$ref":"#/$defs/Instant"}},"additionalProperties":false}
  }
}

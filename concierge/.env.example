CONCIERGE_PORT=4310
# deterministic (offline baseline), azure, or gonka (semantic turn deltas)
CONCIERGE_LANGUAGE_PROVIDER=deterministic
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Default 30000; safely clamped to 1000..120000 milliseconds.
GONKA_TIMEOUT_MS=30000
# local (fixture catalogue) or azure (Azure AI Search candidate discovery)
CONCIERGE_RETRIEVAL_PROVIDER=local
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX=
AZURE_AI_SEARCH_API_VERSION=2024-07-01
RESERVATION_CORE_BASE_URL=http://127.0.0.1:4180
